<Window x:Class="MonasteryRetreat.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام إدارة خلوات بيت دير السيدة العذراء السريان"
        Width="1450"
        Height="950"
        MinWidth="1050"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="{StaticResource Cream}"
        FontFamily="Segoe UI"
        Icon="/Assets/logo.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- RIGHT SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <StackPanel Margin="16,30">

                <TextBlock Text="⛪"
                           FontSize="55"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="نظام إدارة خلوات"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,8,0,5"/>

                <TextBlock Text="بيت دير السيدة العذراء السريان"
                           FontSize="13"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <Border Height="1"
                        Background="{StaticResource SidebarNavHoverBrush}"
                        Margin="0,25,0,20"/>

                <Button x:Name="ReservationsNavButton"
                        Content="▦  الحجوزات"
                        Height="54"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Style="{StaticResource NavButton}"
                        Margin="0,0,0,8"
                        Click="ReservationsNav_Click"/>

                <Button x:Name="AccommodationNavButton"
                        Content="⌂  التسكين"
                        Height="54"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Style="{StaticResource NavButton}"
                        Margin="0,0,0,8"
                        Click="AccommodationNav_Click"/>

                <Button x:Name="LiturgyNavButton"
                        Content="⛪  توزيع القداسات"
                        Height="54"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Style="{StaticResource NavButton}"
                        Margin="0,0,0,8"
                        Click="LiturgyNav_Click"/>

                <Button x:Name="NewReservationNavButton"
                        Content="＋  حجز جديد"
                        Height="54"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Style="{StaticResource NavButton}"
                        Click="NewReservationNav_Click"/>

            </StackPanel>
        </Border>

        <!-- CURRENT PAGE -->
        <ContentControl x:Name="PageHost"
                        Grid.Column="1"
                        IsTabStop="False"/>
    </Grid>
</Window>
