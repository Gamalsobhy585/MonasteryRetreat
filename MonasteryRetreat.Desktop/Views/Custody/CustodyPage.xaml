<UserControl x:Class="MonasteryRetreat.Desktop.Views.Custody.CustodyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource Cream}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#E8F0F4" Padding="25,0">
            <TextBlock Text="⌑   /   المتعلقات"
                       Foreground="{StaticResource Brown}" FontSize="14"
                       VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentRoot" Margin="28,22,28,25">
                <TextBlock Text="المتعلقات والأمانات" FontSize="28"
                           FontWeight="Bold" Foreground="{StaticResource Brown}"/>
                <TextBlock Text="حفظ متعلقات الضيوف المؤكد وصولهم في خزينة الدير، وتوثيق تسليمها عند الاسترداد"
                           FontSize="15" Foreground="#6E655B"
                           Margin="0,4,0,18" TextWrapping="Wrap"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Background="{StaticResource Cream}" Padding="18,12">
                            <TextBlock Text="تسجيل متعلقات جديدة (اختياري)"
                                       Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <Grid Margin="20,18,20,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,14">
                                <TextBlock Text="الضيف المؤكد وصوله *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="GuestSelector" Height="42"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="StayId"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="وصف المتعلق *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="DescriptionBox" Style="{StaticResource FormTextBox}"
                                         MaxLength="300" ToolTip="مثال: هاتف محمول، ظرف نقود ٥٠٠ جنيه، مفتاح سيارة"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="الكمية *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="QuantityBox" Style="{StaticResource FormTextBox}"
                                         Text="1" MaxLength="6"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,14">
                                <TextBlock Text="رقم الخزنة / مكان الحفظ" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="StorageBox" Style="{StaticResource FormTextBox}" MaxLength="120"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14">
                                <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NotesBox" Style="{StaticResource FormTextBox}" MaxLength="1000"/>
                            </StackPanel>
                            <Button Grid.Row="3" Grid.ColumnSpan="3"
                                    Content="＋  حفظ المتعلقات"
                                    Width="190" Height="42" HorizontalAlignment="Right"
                                    Background="{StaticResource Brown}" Foreground="White"
                                    BorderThickness="0" FontWeight="SemiBold"
                                    Click="Add_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Background="{StaticResource Cream}" Padding="18,12">
                            <DockPanel>
                                <Button Content="تحديث" Width="85" Height="32"
                                        DockPanel.Dock="Left"
                                        Background="{StaticResource LightBrown}"
                                        Foreground="White" BorderThickness="0"
                                        Click="Refresh_Click"/>
                                <TextBlock Text="المتعلقات المسجلة"
                                           Style="{StaticResource SectionTitle}"/>
                            </DockPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="18,12,18,10">
                            <TextBlock Text="المحفوظ حاليًا: " FontSize="15"
                                       FontWeight="SemiBold" Foreground="{StaticResource Brown}"/>
                            <TextBlock x:Name="OutstandingCountText" Text="0"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource Brown}"/>
                        </StackPanel>
                        <TextBlock x:Name="EmptyText"
                                   Text="لا توجد متعلقات مسجلة للضيوف الحاليين."
                                   Visibility="Collapsed" Margin="18,10"
                                   Foreground="#6E655B"/>
                        <DataGrid x:Name="ItemsGrid" Margin="18,8,18,20"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  CanUserDeleteRows="False" HeadersVisibility="Column"
                                  RowHeight="46" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrushCustom}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الضيف" Binding="{Binding GuestName}" Width="1.3*"/>
                                <DataGridTextColumn Header="المتعلق" Binding="{Binding ItemDescription}" Width="1.8*"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="70"/>
                                <DataGridTextColumn Header="مكان الحفظ" Binding="{Binding StorageReference}" Width="*"/>
                                <DataGridTextColumn Header="وقت الاستلام" Binding="{Binding ReceivedText}" Width="1.2*"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="*"/>
                                <DataGridTextColumn Header="وقت التسليم" Binding="{Binding ReturnedText}" Width="1.2*"/>
                                <DataGridTemplateColumn Header="الإجراء" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="تسليم" Height="30" Margin="3"
                                                    Foreground="White" BorderThickness="0"
                                                    Background="{StaticResource Brown}"
                                                    IsEnabled="{Binding IsOutstanding}"
                                                    Click="Return_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
