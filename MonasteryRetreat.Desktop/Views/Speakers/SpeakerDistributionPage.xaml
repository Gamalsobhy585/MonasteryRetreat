<UserControl x:Class="MonasteryRetreat.Desktop.Views.Speakers.SpeakerDistributionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource Cream}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E8F0F4" Padding="25,0">
            <TextBlock Text="⌂   /   توزيع المتكلمين"
                       FontSize="14" Foreground="{StaticResource Brown}"
                       VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentRoot" Margin="28,22,28,25">
                <TextBlock Text="توزيع المتكلمين"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource Brown}"/>
                <TextBlock Text="تحديد المتكلم لكل يوم، مع إمكانية تغيير الاسم وحفظ التعديلات."
                           FontSize="15" Foreground="#6E655B"
                           Margin="0,4,0,18"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Background="{StaticResource Cream}" Padding="18,12">
                            <TextBlock Text="إضافة أو تعديل متكلم"
                                       Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <Grid Margin="20,18,20,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="SpeakingDatePicker"
                                            FontSize="15" Height="43"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="اسم المتكلم *" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="SpeakerNameTextBox"
                                         Style="{StaticResource FormTextBox}"
                                         MaxLength="200"
                                         ToolTip="مثال: أبونا يوحنا"/>
                            </StackPanel>
                            <Button Grid.Column="4"
                                    Content="حفظ"
                                    Height="43"
                                    Margin="0,28,0,0"
                                    Background="{StaticResource Brown}"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Click="Save_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Background="{StaticResource Cream}" Padding="18,12">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Left" Content="تحديث"
                                        Width="90" Height="34"
                                        Background="{StaticResource LightBrown}"
                                        Foreground="White" BorderThickness="0"
                                        Click="Refresh_Click"/>
                                <TextBlock Text="جدول توزيع المتكلمين"
                                           Style="{StaticResource SectionTitle}"/>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="EmptyText"
                                   Text="لا توجد توزيعات مسجلة بعد."
                                   Margin="20,15" Foreground="#6E655B"
                                   Visibility="Collapsed"/>
                        <DataGrid x:Name="SpeakersGrid" Margin="18,14,18,20"
                                  MinHeight="190"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="48"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrushCustom}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اليوم" Binding="{Binding DayName}" Width="*"/>
                                <DataGridTextColumn Header="الموافق" Binding="{Binding DateText}" Width="*"/>
                                <DataGridTextColumn Header="المتكلم" Binding="{Binding SpeakerName}" Width="2*"/>
                                <DataGridTemplateColumn Header="الإجراء" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="تعديل" Height="32"
                                                    Margin="5" BorderThickness="0"
                                                    Background="{StaticResource Brown}"
                                                    Foreground="White"
                                                    Click="Edit_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
