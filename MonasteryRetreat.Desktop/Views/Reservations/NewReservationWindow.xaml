<Window x:Class="MonasteryRetreat.Desktop.Views.Reservations.NewReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نظام إدارة خلوات بيت دير السيدة العذراء السريان"
        Width="1450"
        Height="950"
        MinWidth="1050"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        Background="#FFFFFF"
        FontFamily="Segoe UI"
        Icon="/Assets/logo.ico">

    <Window.Resources>

        <SolidColorBrush x:Key="Brown" Color="#512F1C"/>
        <SolidColorBrush x:Key="LightBrown" Color="#AA7953"/>
        <SolidColorBrush x:Key="Cream" Color="#FAF6F1"/>
        <SolidColorBrush x:Key="BorderBrushCustom" Color="#E9E1D9"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Brown}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#242424"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="43"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5DCE5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="43"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5DCE5"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource Cream}"/>
            <Setter Property="Foreground" Value="{StaticResource Brown}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- RIGHT SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource Brown}">
            <StackPanel Margin="16,30">

                <TextBlock Text="⛪"
                           FontSize="55"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="نظام إدارة خلوات"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,8,0,5"/>

                <TextBlock Text="بيت دير السيدة العذراء السريان"
                           FontSize="13"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

                <Border Height="1"
                        Background="#755440"
                        Margin="0,25,0,20"/>

                <Button Content="＋  حجز جديد"
                        Height="54"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Background="{StaticResource LightBrown}"
                        BorderThickness="0"
                        Cursor="Hand"/>

            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0"
                    Background="#EEE0D3"
                    Padding="25,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="⌂   /   حجز جديد"
                               FontSize="14"
                               Foreground="{StaticResource Brown}"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="CurrentDateText"
                               Grid.Column="1"
                               FontSize="14"
                               Foreground="{StaticResource Brown}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="28,22,28,25">

                    <!-- PAGE HEADER -->
                    <TextBlock Text="حجز جديد (عن طريق الهاتف)"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#161616"
                               Margin="0,0,0,5"/>

                    <TextBlock Text="تسجيل حجز جديد لشخص قام بالخلوة"
                               FontSize="16"
                               Foreground="#555555"
                               Margin="0,0,0,18"/>

                    <!-- RESERVATION DATES -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>

                            <Border Background="{StaticResource Cream}"
                                    Padding="18,12">
                                <TextBlock Text="▦  تفاصيل الحجز"
                                           Style="{StaticResource SectionTitle}"/>
                            </Border>

                            <Grid Margin="22,18,22,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="تاريخ الوصول المتوقع *"
                                               Style="{StaticResource FieldLabel}"/>

                                    <DatePicker x:Name="ArrivalDatePicker"
                                                Height="43"
                                                FontSize="15"
                                                SelectedDateChanged="ArrivalDateChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="تاريخ المغادرة المتوقع *"
                                               Style="{StaticResource FieldLabel}"/>

                                    <DatePicker x:Name="DepartureDatePicker"
                                                Height="43"
                                                FontSize="15"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GUEST TYPE -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>

                            <Border Background="{StaticResource Cream}"
                                    Padding="18,12">
                                <TextBlock Text="♟  نوع الضيف"
                                           Style="{StaticResource SectionTitle}"/>
                            </Border>

                            <Grid Margin="22,15,22,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="#F1F5FC"
                                        BorderBrush="#8CB1F4"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="18">

                                    <RadioButton x:Name="FirstTimeRadio"
                                                 GroupName="GuestType"
                                                 IsChecked="True"
                                                 Checked="GuestTypeChanged"
                                                 FontSize="17"
                                                 FontWeight="SemiBold"
                                                 Content="أول مرة — ضيف جديد لم يسبق له الحجز"/>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="#FAFAFA"
                                        BorderBrush="#E2E2E2"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="18">

                                    <RadioButton x:Name="PreviousGuestRadio"
                                                 GroupName="GuestType"
                                                 Checked="GuestTypeChanged"
                                                 FontSize="17"
                                                 FontWeight="SemiBold"
                                                 Content="ضيف سابق — له حجوزات سابقة في الدير"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- NEW GUEST INFORMATION -->
                    <Border x:Name="NewGuestSection"
                            Style="{StaticResource Card}">

                        <StackPanel>

                            <Border Background="{StaticResource Cream}"
                                    Padding="18,12">
                                <TextBlock Text="♟  بيانات الضيف (أول مرة)"
                                           Style="{StaticResource SectionTitle}"/>
                            </Border>

                            <StackPanel Margin="22,18,22,20">

                                <!-- ROW 1 -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="الاسم الكامل *"
                                                   Style="{StaticResource FieldLabel}"/>

                                        <TextBox x:Name="FullNameTextBox"
                                                 Style="{StaticResource FormTextBox}"
                                                 MaxLength="200"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="رقم الهاتف *"
                                                   Style="{StaticResource FieldLabel}"/>

                                        <TextBox x:Name="PhoneTextBox"
                                                 Style="{StaticResource FormTextBox}"
                                                 MaxLength="20"
                                                 FlowDirection="LeftToRight"
                                                 TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 2 -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="المحافظة *"
                                                   Style="{StaticResource FieldLabel}"/>



                                        <ComboBox x:Name="GovernorateComboBox"
                                          Height="43"
                                          FontSize="15"
                                          Foreground="Black"
                                          Background="White"
                                          FlowDirection="RightToLeft"
                                          HorizontalContentAlignment="Right"
                                          VerticalContentAlignment="Center"
                                          BorderBrush="#D5DCE5"
                                          BorderThickness="1"
                                          IsEditable="False"/>


                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="كنيسة الانتماء *"
                                                   Style="{StaticResource FieldLabel}"/>

                                        <TextBox x:Name="GuestChurchTextBox"
                                                 Style="{StaticResource FormTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="السن *"
                                                   Style="{StaticResource FieldLabel}"/>

                                        <TextBox x:Name="AgeTextBox"
                                                 Style="{StaticResource FormTextBox}"
                                                 MaxLength="3"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 3 -->
                                <StackPanel>
                                    <TextBlock Text="ملاحظات"
                                               Style="{StaticResource FieldLabel}"/>

                                    <TextBox x:Name="NotesTextBox"
                                             Style="{StaticResource FormTextBox}"
                                             Height="78"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PREVIOUS GUEST PLACEHOLDER -->
                    <Border x:Name="PreviousGuestSection"
                            Style="{StaticResource Card}"
                            Visibility="Collapsed">

                        <StackPanel>
                            <Border Background="{StaticResource Cream}"
                                    Padding="18,12">
                                <TextBlock Text="بيانات الضيف السابق"
                                           Style="{StaticResource SectionTitle}"/>
                            </Border>

                            <TextBlock Text="سيتم تصميم شاشة البحث عن الضيوف السابقين بشكل منفصل."
                                       Margin="22"
                                       FontSize="15"
                                       Foreground="#777777"/>
                        </StackPanel>
                    </Border>

                    <!-- BUTTONS -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="✔  حفظ الحجز"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource Brown}"
                                Foreground="White"
                                Click="SaveReservation_Click"/>

                        <Button Grid.Column="1"
                                Content="▣  حفظ وإضافة آخر"
                                Style="{StaticResource ActionButton}"
                                Click="SaveAndAdd_Click"/>

                        <Button Grid.Column="2"
                                Content="✖  إلغاء"
                                Style="{StaticResource ActionButton}"
                                Click="Cancel_Click"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
