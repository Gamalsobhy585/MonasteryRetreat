<UserControl x:Class="MonasteryRetreat.Desktop.Views.Reservations.NewReservationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Cream}">

    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0"
                    Background="#E8F0F4"
                    Padding="25,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="⌂   /   حجز جديد"
                               FontSize="14"
                               Foreground="{StaticResource Brown}"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="CurrentDateText"
                               Grid.Column="1"
                               FontSize="14"
                               Foreground="{StaticResource Brown}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="28,22,28,25">

                    <!-- PAGE HEADER -->
                    <TextBlock Text="حجز جديد (عن طريق الهاتف)"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2F2A24"
                               Margin="0,0,0,5"/>

                    <TextBlock Text="تسجيل حجز جديد لشخص قام بالخلوة"
                               FontSize="16"
                               Foreground="#6E655B"
                               Margin="0,0,0,18"/>

                    <!-- RESERVATION DATES -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>

                            <Border Background="{StaticResource Cream}"
                                    Padding="18,12">
                                <TextBlock Text="▦  تفاصيل الحجز"
                                           Style="{StaticResource SectionTitle}"/>
                            </Border>

                            <Grid Margin="22,18,22,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="تاريخ الوصول المتوقع *"
                                               Style="{StaticResource FieldLabel}"/>

                                    <DatePicker x:Name="ArrivalDatePicker"
                                                Height="43"
                                                FontSize="15"
                                                SelectedDateChanged="ArrivalDateChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="تاريخ المغادرة المتوقع *"
                                               Style="{StaticResource FieldLabel}"/>

                                    <DatePicker x:Name="DepartureDatePicker"
                                                Height="43"
                                                FontSize="15"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GUEST TYPE -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>

                            <Border Background="{StaticResource Cream}"
                                    Padding="18,12">
                                <TextBlock Text="♟  نوع الضيف"
                                           Style="{StaticResource SectionTitle}"/>
                            </Border>

                            <Grid Margin="22,15,22,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="#E8F0F4"
                                        BorderBrush="#AFC7D6"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="18">

                                    <RadioButton x:Name="FirstTimeRadio"
                                                 GroupName="GuestType"
                                                 IsChecked="True"
                                                 Checked="GuestTypeChanged"
                                                 FontSize="17"
                                                 FontWeight="SemiBold"
                                                 Content="أول مرة — ضيف جديد لم يسبق له الحجز"/>
                                </Border>

                                <Border Grid.Column="2"
                                        Background="#FAFAFA"
                                        BorderBrush="#E2E2E2"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="18">

                                    <RadioButton x:Name="PreviousGuestRadio"
                                                 GroupName="GuestType"
                                                 Checked="GuestTypeChanged"
                                                 FontSize="17"
                                                 FontWeight="SemiBold"
                                                 Content="ضيف سابق — له حجوزات سابقة في الدير"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- NEW GUEST INFORMATION -->
                    <Border x:Name="NewGuestSection"
                            Style="{StaticResource Card}">

                        <StackPanel>

                            <Border Background="{StaticResource Cream}"
                                    Padding="18,12">
                                <TextBlock Text="♟  بيانات الضيف (أول مرة)"
                                           Style="{StaticResource SectionTitle}"/>
                            </Border>

                            <StackPanel Margin="22,18,22,20">

                                <!-- ROW 1 -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="الاسم الكامل *"
                                                   Style="{StaticResource FieldLabel}"/>

                                        <TextBox x:Name="FullNameTextBox"
                                                 Style="{StaticResource FormTextBox}"
                                                 MaxLength="200"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="رقم الهاتف *"
                                                   Style="{StaticResource FieldLabel}"/>

                                        <TextBox x:Name="PhoneTextBox"
                                                 Style="{StaticResource FormTextBox}"
                                                 MaxLength="11"
                                                 FlowDirection="LeftToRight"
                                                 TextAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 2 -->
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="المحافظة *"
                                                   Style="{StaticResource FieldLabel}"/>



                                        <ComboBox x:Name="GovernorateComboBox"
                                          Height="43"
                                          FontSize="15"
                                          Foreground="Black"
                                          Background="White"
                                          FlowDirection="RightToLeft"
                                          HorizontalContentAlignment="Right"
                                          VerticalContentAlignment="Center"
                                          BorderBrush="#D8D0C4"
                                          BorderThickness="1"
                                          IsEditable="False"/>


                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="كنيسة الانتماء *"
                                                   Style="{StaticResource FieldLabel}"/>

                                        <TextBox x:Name="GuestChurchTextBox"
                                                 Style="{StaticResource FormTextBox}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="تاريخ الميلاد *"
                                                   Style="{StaticResource FieldLabel}"/>

                                        <DatePicker x:Name="DateOfBirthPicker"
                                                    Height="43"
                                                    FontSize="15"
                                                    SelectedDateFormat="Short"
/>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 3 -->
                                <StackPanel>
                                    <TextBlock Text="ملاحظات"
                                               Style="{StaticResource FieldLabel}"/>

                                    <TextBox x:Name="NotesTextBox"
                                             Style="{StaticResource FormTextBox}"
                                             Height="78"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PREVIOUS GUEST -->
                    <Border x:Name="PreviousGuestSection"
                            Style="{StaticResource Card}"
                            Visibility="Collapsed">

                        <StackPanel>
                            <Border Background="{StaticResource Cream}"
                                    Padding="18,12">
                                <TextBlock Text="♟  بيانات الضيف السابق"
                                           Style="{StaticResource SectionTitle}"/>
                            </Border>

                            <StackPanel Margin="22,18,22,20">

                                <!-- SEARCH -->
                                <TextBlock Text="ابحث بالاسم أو رقم الهاتف *"
                                           Style="{StaticResource FieldLabel}"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="GuestSearchTextBox"
                                             Style="{StaticResource FormTextBox}"
                                             KeyDown="GuestSearchTextBox_KeyDown"/>

                                    <Button Grid.Column="2"
                                            Content="🔍  بحث"
                                            Height="43"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Foreground="White"
                                            Background="{StaticResource LightBrown}"
                                            BorderThickness="0"
                                            Click="SearchGuest_Click"/>
                                </Grid>

                                <TextBlock x:Name="SearchStatusText"
                                           FontSize="14"
                                           Foreground="#777777"
                                           Margin="0,0,0,10"
                                           Text="اكتب حرفين على الأقل ثم اضغط بحث."/>

                                <!-- RESULTS -->
                                <DataGrid x:Name="GuestResultsGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#D8D0C4"
                                          BorderBrush="#D8D0C4"
                                          Background="White"
                                          RowHeight="38"
                                          FontSize="14"
                                          MaxHeight="260"
                                          Margin="0,0,0,16"
                                          SelectionChanged="GuestResultsGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="الاسم"
                                                            Binding="{Binding FullName}"
                                                            Width="2*"/>
                                        <DataGridTextColumn Header="الهاتف"
                                                            Binding="{Binding Phone}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="المحافظة"
                                                            Binding="{Binding GovernorateName}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="الكنيسة"
                                                            Binding="{Binding GuestChurch}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="عدد الحجوزات"
                                                            Binding="{Binding ReservationCount}"
                                                            Width="Auto"/>
                                        <DataGridTextColumn Header="آخر زيارة"
                                                            Binding="{Binding LastVisitText}"
                                                            Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- SELECTED GUEST -->
                                <Border x:Name="SelectedGuestCard"
                                        Background="#E8F0F4"
                                        BorderBrush="#AFC7D6"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,12"
                                        Margin="0,0,0,18"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="SelectedGuestText"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="ملاحظات"
                                           Style="{StaticResource FieldLabel}"/>

                                <TextBox x:Name="PreviousNotesTextBox"
                                         Style="{StaticResource FormTextBox}"
                                         Height="78"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                        <!-- BUTTONS -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="✔  حفظ الحجز"
                                Style="{StaticResource ActionButton}"
                                Background="{StaticResource Brown}"
                                Foreground="White"
                                Click="SaveReservation_Click"/>

                        <Button Grid.Column="1"
                                Content="▣  حفظ وإضافة آخر"
                                Style="{StaticResource ActionButton}"
                                Click="SaveAndAdd_Click"/>

                        <Button Grid.Column="2"
                                Content="✖  إلغاء"
                                Style="{StaticResource ActionButton}"
                                Click="Cancel_Click"/>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>
</UserControl>
