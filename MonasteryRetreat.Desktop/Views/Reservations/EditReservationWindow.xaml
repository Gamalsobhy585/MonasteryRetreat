<Window x:Class="MonasteryRetreat.Desktop.Views.Reservations.EditReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل الحجز"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Background="{StaticResource Cream}"
        Icon="/Assets/logo.ico">

    <StackPanel Margin="28,24,28,24">

        <TextBlock x:Name="GuestNameText"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{StaticResource Brown}"
                   Margin="0,0,0,4"/>

        <TextBlock x:Name="HintText"
                   FontSize="13"
                   Foreground="#777777"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"/>

        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="تاريخ الوصول *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="ArrivalDatePicker" Height="43" FontSize="15"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="تاريخ المغادرة *" Style="{StaticResource FieldLabel}"/>
                <DatePicker x:Name="DepartureDatePicker" Height="43" FontSize="15"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NotesTextBox"
                 Style="{StaticResource FormTextBox}"
                 Height="90"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,22"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="SaveButton"
                    Grid.Column="0"
                    Content="✔  حفظ التعديل"
                    Style="{StaticResource ActionButton}"
                    Background="{StaticResource Brown}"
                    Foreground="White"
                    IsDefault="True"
                    Click="Save_Click"/>

            <Button Grid.Column="1"
                    Content="إغلاق"
                    Style="{StaticResource ActionButton}"
                    IsCancel="True"/>
        </Grid>
    </StackPanel>
</Window>
