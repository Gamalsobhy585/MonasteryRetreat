<UserControl x:Class="MonasteryRetreat.Desktop.Views.Reservations.ReservationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FFFFFF">

    <UserControl.Resources>

        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource Cream}"/>
            <Setter Property="Foreground" Value="{StaticResource Brown}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushCustom}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24,18"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="42"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#242424"/>
        </Style>

        <Style x:Key="StatHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#EEE0D3" Padding="25,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="⌂   /   الحجوزات"
                           FontSize="14"
                           Foreground="{StaticResource Brown}"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="CurrentDateText"
                           Grid.Column="1"
                           FontSize="14"
                           Foreground="{StaticResource Brown}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid x:Name="ContentRoot" Grid.Row="1" Margin="28,22,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="الحجوزات"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#161616"
                           Margin="0,0,0,5"/>

                <TextBlock Text="متابعة حجوزات اليوم والقادمة والسابقة، وتأكيد الوصول وإنهاء الإقامة"
                           FontSize="16"
                           Foreground="#555555"/>
            </StackPanel>

            <!-- CARDS -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource StatCard}"
                        Background="#F0F8F1"
                        BorderBrush="#B7DDBC">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="InHouseCountText"
                                   Style="{StaticResource StatNumber}"
                                   Foreground="#2E7D32"
                                   Text="0"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="الضيوف الموجودون حاليًا"
                                       Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="ضيوف تم تأكيد وصولهم ولم تنتهِ إقامتهم بعد"
                                       Style="{StaticResource StatHint}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource StatCard}"
                        Background="#FFF8EC"
                        BorderBrush="#F0D6A4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PendingTodayCountText"
                                   Style="{StaticResource StatNumber}"
                                   Foreground="#B26A00"
                                   Text="0"/>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="حجوزات اليوم لم يتم تأكيدها"
                                       Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="ضيوف موعدهم اليوم ولم يتم تأكيد وصولهم بعد"
                                       Style="{StaticResource StatHint}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- FILTERS -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <Grid Margin="18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="الفترة" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="PeriodComboBox"
                                  Style="{StaticResource FormComboBox}"
                                  SelectedIndex="0"
                                  SelectionChanged="PeriodComboBox_SelectionChanged">
                            <ComboBoxItem Content="الحاضرة (اليوم)" Tag="Present"/>
                            <ComboBoxItem Content="القادمة" Tag="Upcoming"/>
                            <ComboBoxItem Content="السابقة" Tag="Past"/>
                            <ComboBoxItem Content="الملغاة" Tag="Cancelled"/>
                            <ComboBoxItem Content="الكل" Tag="All"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="من تاريخ" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="FromDatePicker"
                                    Height="43"
                                    FontSize="15"
                                    SelectedDateChanged="DateFilter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="إلى تاريخ" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="ToDatePicker"
                                    Height="43"
                                    FontSize="15"
                                    SelectedDateChanged="DateFilter_Changed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="اسم الضيف أو رقم الهاتف" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SearchTextBox"
                                 Style="{StaticResource FormTextBox}"
                                 KeyDown="SearchTextBox_KeyDown"/>
                    </StackPanel>

                    <Button Grid.Column="8"
                            VerticalAlignment="Bottom"
                            Content="🔍  بحث"
                            Height="43"
                            Width="100"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Foreground="White"
                            Background="{StaticResource LightBrown}"
                            BorderThickness="0"
                            Click="Search_Click"/>

                    <Button Grid.Column="10"
                            VerticalAlignment="Bottom"
                            Content="مسح"
                            Height="43"
                            Width="80"
                            FontSize="15"
                            Cursor="Hand"
                            Background="{StaticResource Cream}"
                            Foreground="{StaticResource Brown}"
                            BorderThickness="0"
                            Click="ClearFilters_Click"/>
                </Grid>
            </Border>

            <!-- TABLE -->
            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrushCustom}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource Cream}"
                            Padding="18,12"
                            CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TableTitleText"
                                       Grid.Column="0"
                                       Text="▦  قائمة الحجوزات"
                                       Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="ResultCountText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#666666"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="ReservationsGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#E3D9CE"
                              VerticalGridLinesBrush="#E3D9CE"
                              BorderThickness="0"
                              Background="White"
                              RowHeight="46"
                              FontSize="14"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الاسم"
                                                Binding="{Binding GuestName}"
                                                Width="2*"/>
                            <DataGridTextColumn Header="الهاتف"
                                                Binding="{Binding Phone}"
                                                Width="1.2*"/>
                            <DataGridTextColumn Header="الوصول"
                                                Binding="{Binding ArrivalText}"
                                                Width="Auto"/>
                            <DataGridTextColumn Header="المغادرة"
                                                Binding="{Binding DepartureText}"
                                                Width="Auto"/>
                            <DataGridTextColumn Header="الليالي"
                                                Binding="{Binding Nights}"
                                                Width="Auto"/>

                            <DataGridTemplateColumn Header="الحالة" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Badge"
                                                CornerRadius="10"
                                                Padding="10,3"
                                                Margin="6,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#EEEEEE">
                                            <TextBlock x:Name="BadgeText"
                                                       Text="{Binding StateText}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#444444"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Pending">
                                                <Setter TargetName="Badge" Property="Background" Value="#FFF1D6"/>
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="#8A5300"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="InHouse">
                                                <Setter TargetName="Badge" Property="Background" Value="#DDF1DF"/>
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="#1F6B24"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                <Setter TargetName="Badge" Property="Background" Value="#F8DADA"/>
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="#9B1C1C"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="ملاحظات"
                                                Binding="{Binding Notes}"
                                                Width="1.5*"/>

                            <DataGridTemplateColumn Header="الإجراءات" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                            <Button Content="✔ تأكيد الوصول"
                                                    Style="{StaticResource RowButton}"
                                                    Background="#2E7D32"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Visibility="{Binding CanConfirm, Converter={StaticResource BoolToVis}}"
                                                    Click="ConfirmArrival_Click"/>

                                            <Button Content="⏏ إنهاء الإقامة"
                                                    Style="{StaticResource RowButton}"
                                                    Background="{StaticResource Brown}"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Visibility="{Binding CanEnd, Converter={StaticResource BoolToVis}}"
                                                    Click="EndStay_Click"/>

                                            <Button Content="✎ تعديل"
                                                    Style="{StaticResource RowButton}"
                                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}"
                                                    Click="Edit_Click"/>

                                            <Button Content="✖ إلغاء"
                                                    Style="{StaticResource RowButton}"
                                                    Foreground="#9B1C1C"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"
                                                    Click="CancelReservation_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="EmptyText"
                               Grid.Row="1"
                               Text="لا توجد حجوزات مطابقة."
                               FontSize="16"
                               Foreground="#888888"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
