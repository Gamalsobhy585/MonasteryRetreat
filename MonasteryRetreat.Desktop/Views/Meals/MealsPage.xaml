<UserControl x:Class="MonasteryRetreat.Desktop.Views.Meals.MealsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource Cream}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E8F0F4" Padding="25,0">
            <TextBlock Text="⌂   /   الوجبات"
                       FontSize="14" Foreground="{StaticResource Brown}"
                       VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentRoot" Margin="28,22,28,25">
                <TextBlock Text="الوجبات" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource Brown}"/>
                <TextBlock Text="تسجيل أصناف الإفطار والغداء والعشاء لكل يوم بدون كميات."
                           FontSize="15" Foreground="#6E655B"
                           Margin="0,4,0,18"/>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Background="{StaticResource Cream}" Padding="18,12">
                            <TextBlock Text="إضافة أو تعديل وجبات اليوم"
                                       Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <StackPanel Margin="20,16,20,20">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <TextBlock Text="التاريخ *" Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center" Margin="0,0,0,0"/>
                                <DatePicker x:Name="MenuDatePicker" Margin="14,0,0,0"
                                            FontSize="15" Width="190" Height="43"
                                            SelectedDateChanged="MenuDateChanged"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="الإفطار" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="BreakfastBox" Height="100"
                                             Padding="12,9" FontSize="15"
                                             MaxLength="1000"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             BorderBrush="{StaticResource BorderBrushCustom}"
                                             ToolTip="مثال: فول، جبنة، خبز، شاي"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="الغداء" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="LunchBox" Height="100"
                                             Padding="12,9" FontSize="15"
                                             MaxLength="1000"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             BorderBrush="{StaticResource BorderBrushCustom}"
                                             ToolTip="مثال: أرز، خضار، دجاج"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="العشاء" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="DinnerBox" Height="100"
                                             Padding="12,9" FontSize="15"
                                             MaxLength="1000"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             BorderBrush="{StaticResource BorderBrushCustom}"
                                             ToolTip="مثال: زبادي، جبنة، خبز"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="اترك أي وجبة فارغة إذا لم يتم تحديدها بعد. لا تُسجل كميات."
                                       Margin="0,10" FontSize="12"
                                       Foreground="#6E655B"/>
                            <Button Content="حفظ الوجبات"
                                    Width="170" Height="43"
                                    HorizontalAlignment="Right"
                                    Background="{StaticResource Brown}"
                                    Foreground="White" BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Click="Save_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Background="{StaticResource Cream}" Padding="18,12">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Left" Content="تحديث"
                                        Width="90" Height="34"
                                        Background="{StaticResource LightBrown}"
                                        Foreground="White" BorderThickness="0"
                                        Click="Refresh_Click"/>
                                <TextBlock Text="جدول الوجبات"
                                           Style="{StaticResource SectionTitle}"/>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="EmptyText"
                                   Text="لم يتم تسجيل وجبات بعد."
                                   Margin="20,15"
                                   Visibility="Collapsed"
                                   Foreground="#6E655B"/>
                        <DataGrid x:Name="MealsGrid" Margin="18,14,18,20"
                                  MinHeight="180" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  CanUserDeleteRows="False" RowHeight="65"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrushCustom}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اليوم"
                                                    Binding="{Binding DayName}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="التاريخ"
                                                    Binding="{Binding DateText}"
                                                    Width="125"/>
                                <DataGridTextColumn Header="الإفطار"
                                                    Binding="{Binding Breakfast}"
                                                    Width="2*"/>
                                <DataGridTextColumn Header="الغداء"
                                                    Binding="{Binding Lunch}"
                                                    Width="2*"/>
                                <DataGridTextColumn Header="العشاء"
                                                    Binding="{Binding Dinner}"
                                                    Width="2*"/>
                                <DataGridTemplateColumn Header="الإجراء" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="تعديل" Height="32" Margin="5"
                                                    Background="{StaticResource Brown}"
                                                    Foreground="White" BorderThickness="0"
                                                    Click="Edit_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
