<UserControl x:Class="MonasteryRetreat.Desktop.Views.Liturgy.LiturgyAssignmentsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource Cream}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#E8F0F4" Padding="25,0">
            <DockPanel>
                <TextBlock Text="⛪   /   توزيع القداسات"
                           Foreground="{StaticResource Brown}"
                           FontSize="14"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentRoot" Margin="28,22,28,25">
                <TextBlock Text="توزيع القداسات"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource Brown}"/>
                <TextBlock Text="اختيار الكنيسة ودور الخدمة لكل ضيف مؤكد وصوله"
                           FontSize="15" Foreground="#6E655B"
                           Margin="0,4,0,18"/>

                <Border Style="{StaticResource Card}" Padding="18,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="تاريخ التوزيع" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,0,0"/>
                        <DatePicker x:Name="DistributionDatePicker"
                                    Width="170" Height="36" Margin="14,0"
                                    SelectedDateChanged="DistributionDateChanged"/>
                        <Button Content="تحديث" Width="90" Height="36"
                                Background="{StaticResource Brown}" Foreground="White"
                                BorderThickness="0" Click="Refresh_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Background="{StaticResource Cream}" Padding="18,12">
                            <TextBlock Text="الكنائس والتوزيعات"
                                       Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <ItemsControl x:Name="ChurchesItemsControl" Margin="18,18,4,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="260" MinHeight="145"
                                            Margin="0,0,14,14" Padding="16,14"
                                            CornerRadius="9" Background="White"
                                            BorderBrush="{StaticResource BorderBrushCustom}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding NameAr}"
                                                       FontSize="17" FontWeight="Bold"
                                                       Foreground="{StaticResource Brown}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding GuestCount, StringFormat='عدد الشمامسة: {0}'}"
                                                       Foreground="#7A674A"
                                                       FontSize="12" Margin="0,4,0,10"/>
                                            <ItemsControl ItemsSource="{Binding Assignments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,3">
                                                            <TextBlock Text="{Binding GuestName}"
                                                                       FontSize="14" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding RoleName}"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource LightBrown}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Background="{StaticResource Cream}" Padding="18,12">
                            <TextBlock Text="توزيع الضيوف المؤكد وصولهم"
                                       Style="{StaticResource SectionTitle}"/>
                        </Border>
                        <TextBlock x:Name="EmptyGuestsText"
                                   Text="لا يوجد ضيوف مؤكد وصولهم ضمن الإقامات الحالية لهذا التاريخ."
                                   Foreground="#6E655B" Margin="20,14"
                                   Visibility="Collapsed"/>
                        <DataGrid x:Name="GuestsGrid"
                                  Margin="18,12" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="False" RowHeight="52"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource BorderBrushCustom}"
                                  BorderBrush="{StaticResource BorderBrushCustom}"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم الضيف" Binding="{Binding GuestName}"
                                                    IsReadOnly="True" Width="2*"/>
                                <DataGridTemplateColumn Header="الدور" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Height="34" Margin="5"
                                                      ItemsSource="{Binding DataContext.RoleOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      DisplayMemberPath="NameAr" SelectedValuePath="Value"
                                                      SelectedValue="{Binding SelectedRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="الكنيسة" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox Height="34" Margin="5"
                                                      ItemsSource="{Binding DataContext.ChurchOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      DisplayMemberPath="NameAr" SelectedValuePath="Id"
                                                      SelectedValue="{Binding SelectedChurchId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="الإجراء" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="حفظ" Height="34" Margin="5"
                                                    Background="{StaticResource Brown}" Foreground="White"
                                                    BorderThickness="0" Click="Save_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
